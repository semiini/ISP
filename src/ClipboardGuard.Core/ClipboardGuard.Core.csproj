<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClipboardGuard.Core</RootNamespace>
    <AssemblyName>ClipboardGuard.Core</AssemblyName>
    <Description>Shared data contracts for ClipboardGuard. All models used across engine modules live here.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON serialisation used for ClipboardEvent persistence and inter-module transfer -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
  </ItemGroup>

</Project>
